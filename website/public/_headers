# Headers Cloudflare Pages applies from this file (it is copied into out/ as
# _headers and never served). The Next export hashes everything under
# _next/static/, so those files can be cached for a year. The prerendered search
# index has no file extension, and Pages would label it octet-stream otherwise.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/api/search
  Content-Type: application/json

# The search index is data for the site's own search box, not a page. Keep it
# out of search results even if something links to it.
/api/*
  X-Robots-Tag: noindex

# Crawler-facing files: correct types without relying on Pages' extension map,
# and short caches so an edit shows up the same day.
/sitemap.xml
  Content-Type: application/xml; charset=utf-8
  Cache-Control: public, max-age=3600

/robots.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600

/og.png
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800
